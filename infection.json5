{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["packages"],
        "excludes": ["vendor", "node_modules"]
    },
    // Infection skips mutants whose covering tests take longer than this, and leaves them out of the
    // score: long enough for the slowest (the bridge's tests in separate processes), and
    // tools/infection/no-skipped.php fails the run if any was skipped all the same.
    "timeout": 900,
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "summaryJson": "var/infection/summary.json"
    },
    "tmpDir": "var/cache/infection",
    "mutators": {
        "@default": true,
        // assert() only tells static analysis what a value's type is; mutating it tests nothing.
        "global-ignoreSourceCodeByRegex": [
            "\\\\assert\\(.*"
        ],
        "UnwrapFinally": {
            "ignore": [
                // Equivalent: PHP closes the file, and so releases its lock, as soon as an exception
                // leaves the function, finally or not.
                "YorvoID\\IntentVerifier\\Storage\\LockedFile::run",
                // Equivalent: the finally only wipes the expanded private key (see FunctionCallRemoval).
                "YorvoID\\Core\\Key\\SigningKey::sign"
            ]
        },
        "FunctionCallRemoval": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: the pause between attempts to take the migrations' lock only saves CPU.
                ".*usleep\\(100_000\\).*",
                // Equivalent: wiping the expanded private key from memory after signing can't be observed by a test.
                ".*sodium_memzero\\(\\$secretKey\\);.*"
            ]
        },
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: any size of block finds the same last line, a block or two later.
                ".*private const int BLOCK = 4096;.*",
                // Equivalent: any size of batch deletes the same rows, in more or fewer statements.
                ".*public function deleteInBatches\\(.*int \\$batch = 10_000\\).*",
                // Equivalent: the same pause; and a different default wait can't be observed without
                // waiting that long.
                ".*usleep\\(100_000\\).*",
                ".*Duration::minutes\\(1\\);.*",
                // Equivalent: a scenario's made-up email address is unique at any length of randomness.
                ".*bin2hex\\(random_bytes\\(6\\)\\).*",
                // Equivalent: a step-up that loses the race once reads again; more tries only matter
                // under contention no test can keep up for every try.
                ".*for \\(\\$attempt = 0; \\$attempt < 2; \\+\\+\\$attempt\\).*"
            ]
        },
        "Coalesce": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: only one of the two is known there, the case of both is the match's first arm.
                ".*default => \\$browser \\?\\? \\$system \\?\\? \\$this->text\\('unknown', \\$locale\\),.*"
            ]
        },
        "CastInt": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: PDO counts affected rows as an int, on PostgreSQL and on SQLite.
                ".*\\$count = \\(int\\) \\$this->connection->executeStatement\\(.*"
            ]
        },
        "MatchArmRemoval": {
            "ignore": [
                // Equivalent: without its default arm the match throws, which accepts() takes as a refusal.
                "YorvoID\\Passkeys\\PublicKeyCheck::accepts"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                // Equivalent: anything else than a map has no algorithm to accept.
                "YorvoID\\Passkeys\\PublicKeyCheck::accepts"
            ]
        },
        "BitwiseOr": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: escaped slashes in the virtual authenticator's client data decode to the same origin.
                ".*\\$clientData = json_encode\\(\\[\\.\\.\\.\\['type' => 'webauthn\\..*"
            ]
        },
        "CastString": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: header values are strings either way.
                ".*'Retry-After' => \\(string\\) \\$exception->seconds.*",
                // Equivalent: fread() fails only on a closed file, which the log never reads from.
                ".*\\$tail = \\(string\\) fread\\(.*"
            ]
        },
        "CastFloat": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: PHP subtracts numeric strings as numbers; the casts are for static analysis.
                ".*\\$drift = \\(float\\).*"
            ]
        },
        "GreaterThan": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: two clocks read over a database round trip never differ by exactly 5 or 0 seconds.
                ".*abs\\(\\$drift\\) > self::TOLERANCE_SECONDS.*",
                ".*\\$drift > 0 \\?.*"
            ]
        },
        "LessThan": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: two readings of a microsecond clock are never exactly equal in practice.
                ".*microtime\\(true\\) < \\$deadline.*",
                // Equivalent: see DecrementInteger.
                ".*for \\(\\$attempt = 0; \\$attempt < 2; \\+\\+\\$attempt\\).*"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                // Equivalent: see DecrementInteger.
                ".*private const int BLOCK = 4096;.*",
                ".*public function deleteInBatches\\(.*int \\$batch = 10_000\\).*",
                // Equivalent: asset names have at most one dot, and only the start of the name is
                // compared, so a higher limit can't change the result.
                ".*explode\\('\\.', \\$assetName, 2\\).*",
                // Equivalent: see DecrementInteger.
                ".*usleep\\(100_000\\).*",
                ".*Duration::minutes\\(1\\);.*",
                ".*bin2hex\\(random_bytes\\(6\\)\\).*"
            ]
        }
    },
    // Security-critical code needs ≥ 95 % of covered mutants killed, the rest ≥ 80 % (08 §4).
    // These global floors rise as the security-critical packages arrive.
    "minCoveredMsi": 95,
    "minMsi": 90
}
