{
    "name": "yorvoid/throttle",
    "type": "library",
    "description": "YorvoID's throttle: at most so many attempts per period, per key, shared by every server through the database, atomic under concurrent requests.",
    "keywords": [
        "throttling",
        "rate-limiting",
        "gcra",
        "brute-force",
        "security"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "contact@yorvolabs.com"
        }
    ],
    "support": {
        "email": "contact@yorvolabs.com",
        "issues": "https://github.com/yorvoid/yorvoid/issues",
        "source": "https://github.com/yorvoid/yorvoid/tree/main/packages/throttle",
        "docs": "https://github.com/yorvoid/yorvoid/tree/main/docs",
        "security": "https://github.com/yorvoid/yorvoid/security/policy"
    },
    "require": {
        "php": ">=8.4",
        "ext-filter": "*",
        "doctrine/dbal": "^4.3",
        "psr/clock": "^1.0",
        "symfony/clock": "^7.4 || ^8.1",
        "yorvoid/core": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\Throttle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
