{#- An email's HTML: a language and direction, one column readable at 320 px, real text, a facts table with row headers, links that say where they go, contrast that holds in dark mode. Styles are inline: mail clients drop style sheets. -#}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"><title>{{ subject }}</title></head>
<body style="{% block style %}margin:0;padding:24px 16px;background:#ffffff;color:#1a1a1a;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:16px;line-height:1.5;{% endblock %}">
<div role="article" aria-roledescription="email" aria-label="{{ subject }}" style="max-width:560px;margin:0 auto;">
{% for block in blocks %}
{% if block.kind == 'paragraph' %}
<p style="margin:0 0 16px;">{{ block.text }}</p>
{% elseif block.kind == 'facts' %}
<table style="margin:0 0 16px;border-collapse:collapse;">
{% for label, value in block.facts %}
<tr><th scope="row" style="padding:4px 16px 4px 0;text-align:start;font-weight:600;vertical-align:top;">{{ label }}</th><td style="padding:4px 0;">{{ value }}</td></tr>
{% endfor %}
</table>
{% elseif block.kind == 'action' %}
<p style="margin:24px 0;"><a href="{{ block.url }}" style="display:inline-block;padding:12px 20px;border-radius:6px;background:#1a1a1a;color:#ffffff;font-weight:600;text-decoration:none;">{{ block.label }}</a></p>
<p style="margin:0 0 16px;font-size:14px;color:#4a4a4a;word-break:break-all;">{{ block.url }}</p>
{% elseif block.kind == 'footnote' %}
<hr style="margin:24px 0 16px;border:0;border-top:1px solid #d0d0d0;">
<p style="margin:0;font-size:14px;color:#4a4a4a;">{{ block.text }}</p>
{% endif %}
{% endfor %}
</div>
</body>
</html>
