{
    "name": "yorvoid/mail",
    "type": "library",
    "description": "YorvoID's emails: built from structured content, rendered as plain text and as accessible HTML from a Twig template you can replace, delivered through an interface.",
    "keywords": [
        "email",
        "mail",
        "notifications",
        "accessibility"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "contact@yorvolabs.com"
        }
    ],
    "support": {
        "email": "contact@yorvolabs.com",
        "issues": "https://github.com/yorvoid/yorvoid/issues",
        "source": "https://github.com/yorvoid/yorvoid/tree/main/packages/mail",
        "docs": "https://github.com/yorvoid/yorvoid/tree/main/docs",
        "security": "https://github.com/yorvoid/yorvoid/security/policy"
    },
    "require": {
        "php": ">=8.4",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "twig/twig": "^3.30",
        "yorvoid/core": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\Mail\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
