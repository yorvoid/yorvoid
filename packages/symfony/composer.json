{
    "name": "yorvoid/symfony",
    "type": "symfony-bundle",
    "description": "YorvoID for Symfony: configuration, services, authenticators for any firewall, the user provider and checker, console commands, and the mailer, translator and event glue.",
    "keywords": [
        "symfony",
        "bundle",
        "iam",
        "authentication",
        "passkeys",
        "security"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "poposki.darko@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/yorvoid/yorvoid/issues",
        "source": "https://github.com/yorvoid/yorvoid/tree/main/packages/symfony",
        "docs": "https://github.com/yorvoid/yorvoid/tree/main/docs",
        "security": "https://github.com/yorvoid/yorvoid/security/policy"
    },
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.3",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1",
        "symfony/security-bundle": "^7.4 || ^8.1",
        "symfony/security-core": "^7.4 || ^8.1",
        "symfony/security-http": "^7.4 || ^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^7.4 || ^8.1",
        "yorvoid/authn": "^0.1",
        "yorvoid/core": "^0.1",
        "yorvoid/flows": "^0.1",
        "yorvoid/intent-signing": "^0.1",
        "yorvoid/mail": "^0.1",
        "yorvoid/notifications": "^0.1",
        "yorvoid/passkeys": "^0.1",
        "yorvoid/throttle": "^0.1",
        "yorvoid/translation": "^0.1"
    },
    "suggest": {
        "symfony/mailer": "Sends YorvoID's emails through Symfony Mailer",
        "symfony/translation": "Translates YorvoID's messages with Symfony's translator",
        "symfony/twig-bundle": "Renders the flows' reference pages",
        "symfony/var-dumper": "dump() and the profiler then show YorvoID's secrets redacted"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\Symfony\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
