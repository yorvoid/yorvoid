{# Recovering with a recovery link: the person confirms. View: RecoveryLinkView. #}
{% extends '@YorvoID/flow/layout.html.twig' %}
{% import '@YorvoID/flow/fields.html.twig' as fields %}

{% block title %}{{ 'yorvoid.ui.recovery_link.title'|yorvoid_trans }}{% endblock %}

{% block content %}
    {% if view.account is not null %}
        <p>{{ 'yorvoid.ui.recovery_link.account'|yorvoid_trans({account: view.account}) }}</p>
    {% endif %}
    <p>{{ 'yorvoid.ui.recovery_link.intro'|yorvoid_trans }}</p>
    <form method="post" action="{{ action }}">
        {{ fields.holds(view.holds) }}
        <p><button type="submit">{{ 'yorvoid.ui.recovery_link.submit'|yorvoid_trans }}</button></p>
    </form>
{% endblock %}
