{
    "name": "yorvoid/virtual-authenticator",
    "type": "library",
    "description": "YorvoID's virtual authenticator: a software WebAuthn authenticator for tests that answers registration and sign-in options as a browser would, and misbehaves on request.",
    "keywords": [
        "webauthn",
        "passkeys",
        "fido2",
        "testing",
        "virtual-authenticator"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "poposki.darko@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/yorvoid/yorvoid/issues",
        "source": "https://github.com/yorvoid/yorvoid/tree/main/packages/virtual-authenticator",
        "docs": "https://github.com/yorvoid/yorvoid/tree/main/docs",
        "security": "https://github.com/yorvoid/yorvoid/security/policy"
    },
    "require": {
        "php": ">=8.5",
        "ext-openssl": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\VirtualAuthenticator\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable"
}
