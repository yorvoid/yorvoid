{
    "name": "yorvoid/authn",
    "type": "library",
    "description": "YorvoID's authentication: sessions, one-time tokens, setup and recovery codes, step-up and throttling.",
    "keywords": [
        "iam",
        "authentication",
        "sessions",
        "security"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "poposki.darko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.3",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/clock": "^8.1",
        "symfony/translation-contracts": "^3.6",
        "symfony/uid": "^8.1",
        "yorvoid/core": "^0.1",
        "yorvoid/mail": "^0.1",
        "yorvoid/throttle": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\Authn\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable"
}
