{
    "name": "yorvoid/policy",
    "type": "library",
    "description": "YorvoID's policy: declared abilities, roles with super roles and strict abilities, a realm's changes to the defaults, roles on resources, and rules, as the evaluator's elements.",
    "keywords": [
        "authorization",
        "rbac",
        "roles",
        "permissions",
        "access-control",
        "security"
    ],
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Darko Poposki",
            "email": "contact@yorvolabs.com"
        }
    ],
    "support": {
        "email": "contact@yorvolabs.com",
        "issues": "https://github.com/yorvoid/yorvoid/issues",
        "source": "https://github.com/yorvoid/yorvoid/tree/main/packages/policy",
        "docs": "https://github.com/yorvoid/yorvoid/tree/main/docs",
        "security": "https://github.com/yorvoid/yorvoid/security/policy"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.3",
        "psr/clock": "^1.0",
        "symfony/clock": "^7.4 || ^8.1",
        "yorvoid/core": "^0.4",
        "yorvoid/relations": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "YorvoID\\Policy\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
