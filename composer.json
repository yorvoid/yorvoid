{
    "name": "yorvoid/yorvoid",
    "type": "project",
    "description": "YorvoID development monorepo: every package, their tests, and the tools that check them.",
    "homepage": "https://github.com/yorvoid/yorvoid",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "yorvoid/authn": "0.5.x-dev",
                    "yorvoid/core": "0.5.x-dev",
                    "yorvoid/flows": "0.5.x-dev",
                    "yorvoid/intent-signing": "0.5.x-dev",
                    "yorvoid/intent-verifier": "0.5.x-dev",
                    "yorvoid/mail": "0.5.x-dev",
                    "yorvoid/notifications": "0.5.x-dev",
                    "yorvoid/passkeys": "0.5.x-dev",
                    "yorvoid/phpstan-rules": "0.5.x-dev",
                    "yorvoid/policy": "0.5.x-dev",
                    "yorvoid/policy-testing": "0.5.x-dev",
                    "yorvoid/relations": "0.5.x-dev",
                    "yorvoid/symfony": "0.5.x-dev",
                    "yorvoid/testing": "0.5.x-dev",
                    "yorvoid/throttle": "0.5.x-dev",
                    "yorvoid/translation": "0.5.x-dev",
                    "yorvoid/virtual-authenticator": "0.5.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.30",
        "yorvoid/authn": "^0.5",
        "yorvoid/core": "^0.5",
        "yorvoid/flows": "^0.5",
        "yorvoid/intent-signing": "^0.5",
        "yorvoid/intent-verifier": "^0.5",
        "yorvoid/mail": "^0.5",
        "yorvoid/notifications": "^0.5",
        "yorvoid/passkeys": "^0.5",
        "yorvoid/phpstan-rules": "^0.5",
        "yorvoid/policy": "^0.5",
        "yorvoid/policy-testing": "^0.5",
        "yorvoid/relations": "^0.5",
        "yorvoid/symfony": "^0.5",
        "yorvoid/testing": "^0.5",
        "yorvoid/throttle": "^0.5",
        "yorvoid/translation": "^0.5",
        "yorvoid/virtual-authenticator": "^0.5"
    },
    "require-dev": {
        "brianium/paratest": "^7.29",
        "deptrac/deptrac": "^4.7",
        "doctrine/doctrine-bundle": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.8",
        "innmind/black-box": "^7.0",
        "nikic/php-fuzzer": "^0.0.11",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symfony/browser-kit": "^7.4 || ^8.1",
        "symfony/css-selector": "^7.4 || ^8.1",
        "symfony/expression-language": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/http-client": "^7.4 || ^8.1",
        "symfony/mailer": "^7.4 || ^8.1",
        "symfony/security-bundle": "^7.4 || ^8.1",
        "symfony/translation": "^7.4 || ^8.1",
        "symfony/twig-bundle": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "YorvoID\\Bench\\": "tools/bench/",
            "YorvoID\\E2e\\": "e2e/app/src/",
            "YorvoID\\Tests\\": "tests/",
            "YorvoID\\Tools\\PHPStan\\": "tools/phpstan/src/"
        },
        "classmap": [
            "tests/PhpstanRules/data/"
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "deptrac": "deptrac analyse --no-progress",
        "dependencies": "sh tools/dependencies/check.sh",
        "versions": "@php tools/release/version.php check",
        "bc": [
            "@composer install -d tools/compat/bc --no-interaction --no-progress --quiet",
            "@php tools/compat/bc-check.php"
        ],
        "test": "paratest",
        "test-serial": "phpunit",
        "test-fips": "paratest --exclude-group ed25519-keys",
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d opcache.enable_cli=1 -d pcov.enabled=0 tools/bench/run.php --out=var/bench/run.json",
            "@php tools/bench/bench.php report var/bench/run.json"
        ],
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/infection/no-skipped.php clear",
            "@php tools/infection/coverage.php",
            "@php -d memory_limit=4G vendor/bin/infection --threads=max --only-covering-test-cases --show-mutations --coverage=var/infection/coverage --skip-initial-tests",
            "@php tools/infection/no-skipped.php"
        ],
        "docs-reference": "YORVOID_WRITE_REFERENCE=1 phpunit --filter ReferenceDocsTest",
        "qa": [
            "@composer validate --strict --no-check-publish",
            "@cs",
            "@phpstan",
            "@deptrac",
            "@dependencies",
            "@versions",
            "@bc",
            "@test"
        ],
        "fuzz": [
            "Composer\\Config::disableProcessTimeout",
            "sh fuzz/run.sh"
        ]
    },
    "scripts-descriptions": {
        "cs": "Checks the coding style",
        "cs-fix": "Fixes the coding style",
        "phpstan": "Static analysis at the maximum level",
        "deptrac": "Checks the dependency rules between packages",
        "dependencies": "Checks that each package requires what it uses, and uses what it requires",
        "bc": "Checks the compatibility promise against the last release: every break of @api code is in the changelog",
        "test": "Runs the tests",
        "bench": "Runs the benchmarks (PostgreSQL), and writes their table",
        "infection": "Mutation testing",
        "docs-reference": "Writes the reference pages from the code: the configuration and the console commands",
        "qa": "Everything CI checks, in order",
        "fuzz": "Fuzzes the parsers; any crash fails"
    },
    "extra": {
        "phpstan/extension-installer": {
            "ignore": [
                "yorvoid/phpstan-rules"
            ]
        }
    }
}
